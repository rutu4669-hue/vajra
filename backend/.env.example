# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_security_platform
POSTGRES_USER=ai_security_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_security_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys
ALIENVAULT_OTX_API_KEY=your_otx_api_key
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key
THREATFOX_API_KEY=your_threatfox_api_key
SHODAN_API_KEY=your_shodan_api_key

# Application
APP_NAME=AI Security Platform
APP_VERSION=1.0.0
DEBUG=True
